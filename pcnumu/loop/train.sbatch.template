#!/bin/bash
#SBATCH --job-name={job_name}
#SBATCH --partition={partition}
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task={cpus}
#SBATCH --mem={mem}
#SBATCH --time={time}
#SBATCH --output={run_dir}/slurm-%j.out

# Run {trial}-{horn}. Generated by `pcnumu/loop/loop.py prepare` from
# pcnumu/loop/train.sbatch.template. Do not edit: the GO record pins this file's sha256.
# Submit with `python pcnumu/loop/loop.py submit {trial}` (Oscar only).
set -euo pipefail

CODE_DIR={code_dir}
RUN_DIR={run_dir}
TRIAL={trial}
HORN={horn}

source /common/users/chow/miniforge3/etc/profile.d/conda.sh
conda activate transformer_ee
export PATH=/data/chow/tools/git-env/bin:$PATH
export WANDB_MODE=offline
cd "$CODE_DIR"
export PYTHONPATH="$CODE_DIR"

# Records commit, dirty flag and hashes in $RUN_DIR/provenance.json. Exits non-zero (and the
# job stops here, before the GPU is touched) unless the checkout is clean, at the GO-signed
# commit, and every signed file is unchanged.
python -I pcnumu/loop/loop.py job-start "$TRIAL" "$HORN"

hostname
nvidia-smi
python -c 'import torch; assert torch.cuda.is_available(), "CUDA GPU not visible"; print("GPU:", torch.cuda.get_device_name(0))'
mkdir -p "$RUN_DIR/wandb"

python train_wide.py \
  --base-config "$RUN_DIR/effective_config.json" \
  --wandb-project pcnumu \
  --wandb-id "${TRIAL}_${HORN}_${SLURM_JOB_ID}" \
  --wandb-dir "$RUN_DIR/wandb"

# Evaluation hand-off after successful training: issue #5.
